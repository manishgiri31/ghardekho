{
  "name": "@ghardekho/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "generate": "node prisma/run-prisma.mjs generate --schema prisma/schema.prisma",
    "postinstall": "npm run generate",
    "build": "npm run generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "node prisma/run-prisma.mjs migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "node prisma/run-prisma.mjs migrate deploy --schema prisma/schema.prisma",
    "validate": "node prisma/run-prisma.mjs validate --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": { "@prisma/client": "6.12.0", "dotenv": "^16.6.1" },
  "devDependencies": { "bcryptjs": "^3.0.2", "prisma": "6.12.0", "tsx": "^4.20.5", "typescript": "^5.9.0" }
}
