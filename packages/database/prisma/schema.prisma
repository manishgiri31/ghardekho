generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  AGENT
  OWNER
  ADMIN
  SUPER_ADMIN
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  PLOT
  COMMERCIAL
  OFFICE
  SHOP
  WAREHOUSE
  OTHER
}

enum ListingType {
  SALE
  RENT
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SOLD
  RENTED
  ARCHIVED
}

enum AreaUnit {
  SQFT
  SQM
  ACRE
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}

enum PossessionStatus {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
  NEW_LAUNCH
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(254)
  phone           String?        @unique @db.VarChar(20)
  passwordHash    String         @db.VarChar(255)
  role            Role           @default(USER)
  isActive        Boolean        @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  profile         Profile?
  sessions        AuthSession[]
  properties      Property[]
  favorites       Favorite[]
  inquiries       Inquiry[]
  visitRequests   VisitRequest[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([role, isActive])
  @@index([createdAt])
}

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  name      String   @db.VarChar(120)
  avatar    String?  @db.VarChar(2048)
  bio       String?  @db.VarChar(2000)
  city      String?  @db.VarChar(100)
  state     String?  @db.VarChar(100)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city, state])
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.Char(64)
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Property {
  id               String           @id @default(uuid()) @db.Uuid
  title            String           @db.VarChar(160)
  slug             String           @unique @db.VarChar(180)
  description      String           @db.VarChar(10000)
  propertyType     PropertyType
  listingType      ListingType
  status           PropertyStatus   @default(DRAFT)
  price            Decimal          @db.Decimal(14, 2)
  area             Decimal          @db.Decimal(12, 2)
  areaUnit         AreaUnit          @default(SQFT)
  bedrooms         Int?
  bathrooms        Int?
  balconies        Int?
  floorNumber      Int?
  totalFloors      Int?
  furnishing       Furnishing?
  possessionStatus PossessionStatus?
  address          String           @db.VarChar(240)
  locality         String           @db.VarChar(120)
  city             String           @db.VarChar(100)
  state            String           @db.VarChar(100)
  pincode          String           @db.Char(6)
  latitude         Decimal?         @db.Decimal(10, 7)
  longitude        Decimal?         @db.Decimal(10, 7)
  ownerId          String           @db.Uuid
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  media            PropertyMedia[]
  amenities        PropertyAmenity[]
  favorites        Favorite[]
  inquiries        Inquiry[]
  visitRequests    VisitRequest[]
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, listingType, propertyType, createdAt])
  @@index([city, locality, status])
  @@index([price, status])
  @@index([bedrooms, status])
  @@index([furnishing, status])
  @@index([ownerId, status, createdAt])
}

model PropertyMedia {
  id         String     @id @default(uuid()) @db.Uuid
  propertyId String     @db.Uuid
  url        String     @db.VarChar(2048)
  type       MediaType  @default(IMAGE)
  sortOrder  Int        @default(0)
  altText    String?    @db.VarChar(300)
  isPrimary  Boolean    @default(false)
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  @@index([propertyId, sortOrder])
  @@index([propertyId, isPrimary])
}

model Amenity {
  id         String            @id @default(uuid()) @db.Uuid
  name       String            @unique @db.VarChar(80)
  slug       String            @unique @db.VarChar(100)
  properties PropertyAmenity[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model PropertyAmenity {
  propertyId String   @db.Uuid
  amenityId  String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId, propertyId])
}

model Favorite {
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, propertyId])
  @@index([propertyId])
}

model Inquiry {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  message    String   @db.VarChar(3000)
  phone      String?  @db.VarChar(20)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
  @@index([userId, createdAt])
}

model VisitRequest {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  propertyId  String   @db.Uuid
  requestedAt DateTime
  message     String?  @db.VarChar(1000)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId, requestedAt])
  @@index([userId, requestedAt])
}
